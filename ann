                        <div className="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 flex flex-col text-wrap"><div className="bg-rose-600 text-white px-4 py-1 rounded-full text-[10px] font-bold self-start mb-4 uppercase tracking-widest text-nowrap">Second Semester / 下學期</div><h6 className="font-black text-slate-800 mb-4 text-xl text-nowrap">進階實務訓練</h6><div className="flex-1 flex flex-col justify-center items-center text-center p-6 border-2 border-dashed border-rose-100 rounded-2xl"><TrendingUp className="text-rose-300 mb-3" size={48} /><p className="text-sm font-medium text-slate-600 leading-relaxed text-wrap">依實習生個別發展狀況，進行差異化任務安排，強化其專業整合能力。</p></div></div>
                      </div>
                    </div>
                  </div>
                  <div className="p-6 bg-white border-t border-slate-100 flex justify-center gap-3 flex-wrap shrink-0">
                    {selectedDoc.docLinks?.map((link) => (<a key={link.label} href={link.url} target="_blank" rel="noopener noreferrer" className="flex items-center gap-2 px-5 py-2 bg-teal-600 text-white rounded-full text-xs font-bold shadow-md hover:bg-indigo-700 transition-all hover:scale-105 active:scale-95 text-nowrap"><AwardIcon size={14} /> {link.label}</a>))}
                  </div>
                </div>
              ) : selectedDoc.special23 ? (
                /* 2-3 統計嵌入視圖 */
                <div className="flex-1 flex flex-col bg-white overflow-hidden text-wrap text-nowrap">
                  <div className="bg-teal-50/50 p-4 border-b border-teal-100 flex justify-center gap-2 shrink-0 text-wrap text-nowrap">
                    <button onClick={() => setSubView23('text')} className={`flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold transition-all shadow-sm ${subView23 === 'text' ? 'bg-teal-600 text-white' : 'bg-white border border-teal-200 text-teal-700 hover:bg-teal-50'}`}><FileType size={12} /> 文字簡介</button>
                    <button onClick={() => { setSubView23('stat1'); setZoomScale(1); }} className={`flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold transition-all shadow-sm ${subView23 === 'stat1' ? 'bg-rose-600 text-white' : 'bg-white border border-rose-200 text-rose-700 hover:bg-rose-50'}`}><BarChart3 size={12} /> 輔導統計</button>
                    <button onClick={() => { setSubView23('stat2'); setZoomScale(1); }} className={`flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold transition-all shadow-sm ${subView23 === 'stat2' ? 'bg-rose-600 text-white' : 'bg-white border border-rose-200 text-rose-700 hover:bg-rose-50'}`}><BarChart3 size={12} /> 相關統計 (一)</button>
                    <button onClick={() => { setSubView23('stat3'); setZoomScale(1); }} className={`flex items-center gap-1 px-3 py-1.5 rounded-full text-[11px] font-bold transition-all shadow-sm ${subView23 === 'stat3' ? 'bg-rose-600 text-white' : 'bg-white border border-rose-200 text-rose-700 hover:bg-rose-50'}`}><BarChart3 size={12} /> 相關統計 (二)</button>
                  </div>
                  <div className="flex-1 overflow-auto p-10 bg-slate-50">
                    {subView23 === 'text' ? (
                      <div className="max-w-3xl mx-auto space-y-6 text-slate-700 text-lg leading-loose font-normal text-wrap text-nowrap"><p className="indent-8 text-wrap">本人擔任校內體育班及音樂班之專責輔導教師，具備 13 年輔導實務經驗，長期服務於第一線學生輔導工作。服務對象涵蓋多元類型學生，累積處理豐富個案經驗。</p></div>
                    ) : (
                      <div className="flex flex-col items-center gap-4 h-full text-wrap text-nowrap">
                        <div className="bg-white/80 backdrop-blur p-2 rounded-xl border border-slate-200 flex gap-4 shrink-0 shadow-sm"><button onClick={handleZoomOut} className="p-1 hover:bg-slate-200 rounded-lg text-slate-600"><ZoomOut size={18} /></button><input type="range" min="0.5" max="3" step="0.1" value={zoomScale} onChange={(e) => setZoomScale(parseFloat(e.target.value))} className="w-24 h-1.5 mt-2.5 accent-teal-600" /><button onClick={handleZoomIn} className="p-1 hover:bg-slate-200 rounded-lg text-slate-600"><ZoomIn size={18} /></button><button onClick={() => setZoomScale(1)} className="p-1 hover:bg-slate-200 rounded-lg text-slate-600"><RotateCcw size={18} /></button></div>
                        <div className="flex-1 flex items-start justify-center cursor-grab active:cursor-grabbing w-full overflow-auto p-4"><div style={{ width: `${85 * zoomScale}%`, minWidth: '300px' }} className="shadow-xl bg-white rounded-lg"><img src={subView23 === 'stat1' ? selectedDoc.stat1Url : subView23 === 'stat2' ? selectedDoc.stat2Url : selectedDoc.stat3Url} alt="統計圖" className="w-full h-auto rounded-lg" /></div></div>
                      </div>
                    )}
                  </div>
                </div>
              ) : selectedDoc.isEmbedded ? (
                <div className="flex-1 flex flex-col bg-slate-200 overflow-hidden text-wrap text-nowrap">
                   {selectedDoc.id === '1-7' && (
                     <div className="bg-indigo-50/50 p-3 border-b border-indigo-100 flex justify-center gap-3 shrink-0">
                        <button onClick={() => setSubView17('pdf')} className="flex items-center gap-1.5 px-4 py-1 rounded-full text-[11px] font-bold bg-indigo-600 text-white shadow-sm transition-all"><FileType size={12} /> 教案檔案</button>
                        <button onClick={() => { setSubView17('gallery'); setGalleryIndex(0); setZoomScale(1); }} className="flex items-center gap-1.5 px-4 py-1 rounded-full text-[11px] font-bold bg-white border border-rose-200 text-rose-700 hover:bg-rose-50 transition-all shadow-sm"><Images size={12} /> 上台報告照片</button>
                     </div>
                   )}
                   <iframe src={selectedDoc.embedUrl} className="flex-1 w-full border-none" allow="autoplay"></iframe>
                   <div className="p-4 bg-white border-t border-slate-100 flex justify-center gap-2 flex-wrap shrink-0">
                    {selectedDoc.outcomes?.map((outcome, idx) => (
                      <a key={outcome.label} href={outcome.url} target="_blank" rel="noopener noreferrer" className={`flex items-center gap-1.5 px-3 py-1.5 border rounded-full text-xs font-semibold transition-all shadow-sm ${idx % 2 === 0 ? 'bg-white border-rose-200 text-rose-700 hover:bg-rose-600 hover:text-white' : 'bg-white border-teal-200 text-teal-700 hover:bg-teal-600 hover:text-white'}`}><ExternalLink size={14} /> {outcome.label}</a>
                    ))}
                  </div>
                </div>
              ) : (selectedDoc.directImageUrl || selectedDoc.gallery) ? (
                <div className="flex-1 flex flex-col bg-slate-100 relative overflow-hidden">
                   <div className="bg-white/90 backdrop-blur border-b border-slate-200 p-3 flex items-center justify-center gap-4 shrink-0 flex-wrap shadow-sm z-10 text-nowrap">
                      <button onClick={handleZoomOut} className="p-1 hover:bg-slate-200 rounded-lg text-slate-600"><ZoomOut size={20} /></button>
                      <input type="range" min="0.5" max="4" step="0.1" value={zoomScale} onChange={(e) => setZoomScale(parseFloat(e.target.value))} className="w-32 h-1.5 accent-teal-600" />
                      <button onClick={handleZoomIn} className="p-1 hover:bg-slate-200 rounded-lg text-slate-600"><ZoomIn size={20} /></button>
                      <button onClick={handleResetZoom} className="p-1 hover:bg-slate-200 rounded-lg text-slate-600"><RotateCcw size={20} /></button>
                      <div className="w-px h-6 bg-slate-200 mx-2 hidden sm:block"></div>
                      <div className="flex items-center gap-3 flex-wrap">
                        {selectedDoc.fullUrl && <a href={selectedDoc.fullUrl} target="_blank" rel="noopener noreferrer" className="text-sm font-bold text-teal-600 hover:underline border-r pr-3 border-slate-200 text-nowrap"><ExternalLink size={16} /> 完整檔案</a>}
                      </div>
                   </div>
                   <div className="flex-1 overflow-auto p-4 md:p-8 flex flex-col items-center text-wrap text-nowrap text-wrap">
                      <div className="flex items-center justify-center min-h-full w-full">
                        <div className="bg-white shadow-xl rounded-lg overflow-hidden transition-all duration-200" style={{ width: `${90 * zoomScale}%`, maxWidth: 'none', minWidth: '320px' }}>
                          <img src={currentGalleryUrl || selectedDoc.directImageUrl} alt="佐證圖" className="w-full h-auto" />
                        </div>
                      </div>
                   </div>
                </div>
              ) : (
                <div className="flex-1 flex flex-col items-center justify-center gap-8 text-center p-12 text-slate-400 text-wrap text-nowrap"><div className="space-y-4 flex flex-col items-center text-wrap text-nowrap"><FileText size={64} strokeWidth={1} /><div><p className="font-bold text-slate-600 text-2xl text-wrap text-nowrap">實體佐證資料</p><p className="text-lg font-medium mt-1 text-wrap text-nowrap">本項目已歸檔於新北高中輔導室，歡迎到校審閱。</p></div></div></div>
              )}
            </div>
            <div className="p-4 bg-slate-50 border-t border-slate-100 flex justify-center shrink-0 text-center text-wrap text-nowrap"><p className="text-[10px] text-slate-400 font-bold uppercase tracking-widest text-wrap text-nowrap text-nowrap">蔡雅安 教師專業作品集 · 數位佐證展示</p></div>
          </div>
        </div>
      )}

      {/* 修正後的 Footer */}
      <footer className="bg-white border-t border-slate-200 py-12 px-6 text-wrap text-center text-nowrap"><div className="text-xl font-bold text-teal-700 font-serif italic tracking-wider mb-2 text-nowrap text-nowrap">蔡雅安</div><div className="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-loose text-nowrap text-nowrap">© 2026 蔡雅安 Tsai Ya-An 教師專業數位作品集. All Rights Reserved.</div></footer>
    </div>
  );
};

export default App;
